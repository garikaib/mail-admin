# Postfix main.cf (Development Sandbox Config)

myhostname = mail.zimprices.co.zw
myorigin = /etc/mailname
mydestination = localhost, localhost.localdomain
relayhost = 
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = all

# TLS Parameters
smtpd_tls_cert_file = /etc/lego/certificates/zimprices.co.zw.crt
smtpd_tls_key_file = /etc/lego/certificates/zimprices.co.zw.key
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes

# SASL Parameters
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes

# Handover virtual mailbox configurations
virtual_mailbox_domains = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-domains.cf
virtual_mailbox_maps = proxy:mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf
virtual_alias_maps = proxy:mysql:/etc/postfix/mysql-virtual-alias-maps.cf
virtual_transport = lmtp:unix:private/dovecot-lmtp
